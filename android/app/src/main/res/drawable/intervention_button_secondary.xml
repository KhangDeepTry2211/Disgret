<?xml version="1.0" encoding="utf-8"?>
<!-- 2.3 Nút phụ trên màn can thiệp: hình viên thuốc nền trong, viền trắng. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/intervention_secondary_ripple">
    <item>
        <shape android:shape="rectangle">
            <stroke
                android:width="1dp"
                android:color="@color/disgret_white" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="@color/disgret_white" />
            <corners android:radius="999dp" />
        </shape>
    </item>
</ripple>
